# systemd service for the VPS: keeps Tracer running and restarts it after crashes and reboots.
# Install: see README.md, "Run it on the VPS".
[Unit]
Description=Tracer, the TraceCore Lab Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tracer
WorkingDirectory=/opt/tracecore/discord-bot
ExecStart=/opt/tracecore/discord-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
