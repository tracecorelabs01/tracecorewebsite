# A template of the bot's settings. This file is public on GitHub, so never put real values in it.
# The real settings live on the droplet in /etc/tracer.env (or in a .env file to run the bot on your computer).

# Discord Developer Portal → your app → Bot → Reset Token
BOT_TOKEN=

# Your Discord user ID(s), comma-separated, for full access. Server administrators always have it.
ADMIN_IDS=

# The website, and the same secret as BOT_API_KEY in the website's environment variables.
STORE_URL=https://tracecorelab.com
STORE_API_KEY=

# true = use data/bot_test.db instead of data/bot.db
TEST_MODE=false

# The AI assistant (optional): a DeepSeek API key from platform.deepseek.com → API keys. Empty = AI off.
DEEPSEEK_API_KEY=
# Most AI replies per day, across the whole server, to cap spending.
AI_DAILY_LIMIT=300
# Only if DeepSeek renames its models: the model the assistant uses (default deepseek-flash).
DEEPSEEK_MODEL=
