# Copy to .env on the server and fill in. Never commit .env or share it.

# Discord Developer Portal → your app → Bot → Reset Token
BOT_TOKEN=

# Your Discord user ID(s), comma-separated, for full access. Server administrators always have it.
ADMIN_IDS=

# The website, and the same secret as BOT_API_KEY in the website's environment variables.
STORE_URL=https://tracecorelab.com
STORE_API_KEY=

# true = use data/bot_test.db instead of data/bot.db
TEST_MODE=false
