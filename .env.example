# ── Database (remote MySQL / MariaDB) ───────────────────────────
# mysql://USER:PASSWORD@HOST:3306/DATABASE   (URL-encode special characters in the password)
DATABASE_URL=
# Set to "true" if your host requires TLS (PlanetScale, AWS RDS, Azure, most cloud MySQL).
DATABASE_SSL=false
# Keep small on shared hosting (connection limits per user).
DATABASE_POOL_SIZE=5

# ── Uploads ─────────────────────────────────────────────────────
# "local" stores files on this server's disk (VPS / Node hosting).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze, DO Spaces) — required on serverless hosts.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for the bucket (e.g. https://cdn.example.com)
S3_PUBLIC_URL=

# ── Email (optional) ────────────────────────────────────────────
# Order confirmations + new-order alerts via Resend (https://resend.com). Leave blank to disable.
RESEND_API_KEY=
EMAIL_FROM="TraceCoreLab <orders@tracecorelab.com>"
ORDER_ALERT_EMAIL=

# ── Card payments: Razorpay (optional) ──────────────────────────
# Dashboard → Account & Settings → API keys. Without these, card orders get payment instructions like PayPal/crypto.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://YOUR-DOMAIN/api/razorpay/webhook with events payment.captured,
# payment.failed, order.paid, refund.processed, and this secret.
RAZORPAY_WEBHOOK_SECRET=
